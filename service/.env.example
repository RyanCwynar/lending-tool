# Postgres (matches docker-compose defaults; use localhost when running the app outside Docker)
DATABASE_URL=postgres://morpho:morpho@localhost:5432/morpho

# JSON-RPC endpoint for Base mainnet. Public endpoints are rate-limited; use your own for backfills.
RPC_URL=https://mainnet.base.org
# Expected chain id. The service checks it against eth_chainId so a misconfigured RPC is caught early.
CHAIN_ID=8453

PORT=4000
LOG_LEVEL=info
