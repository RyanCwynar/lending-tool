{
  "name": "morpho-lending-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "migrate:prod": "node dist/db/migrate-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "capture-fixture": "tsx src/harness/capture-fixture.ts",
    "mock-rpc": "tsx src/harness/mock-rpc.ts",
    "mock-receivers": "tsx src/harness/mock-receivers.ts",
    "replay": "tsx src/harness/replay.ts"
  },
  "dependencies": {
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "viem": "^2.57.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
